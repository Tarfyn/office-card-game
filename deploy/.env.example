PUBLIC_BASE_URL=https://play.example.com
RUNTIME_DIR=/srv/office-card-game/runtime
ADMIN_TOKEN=replace-with-a-long-random-secret
TRUST_PROXY=1
REQUIRE_HTTPS=1
HOST=127.0.0.1
PORT=8787
PROFILE_STORAGE_BACKEND=FILE_JSON_LOCAL
DATABASE_REQUIRED=0
# DATABASE_URL is generated and written only by the root-owned ocg-db-helper.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
