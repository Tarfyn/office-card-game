[Unit]
Description=Office Card Game PostgreSQL backup
After=postgresql.service
ConditionPathExists=/usr/local/sbin/ocg-db-helper

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/ocg-db-helper backup-now
UMask=0077
NoNewPrivileges=true
AmbientCapabilities=CAP_SETUID
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
# The helper intentionally drops from root to the fixed postgres OS user for
# pg_dump/pg_restore. Ambient CAP_SETUID restores only that transition while
# NoNewPrivileges and the remaining sandbox restrictions stay enabled.
ReadWritePaths=/srv/office-card-game/backups/postgresql /var/lib/office-card-game-db-helper /run/lock
